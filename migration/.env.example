# Kopiere zu .env und passe Werte an. .env NICHT ins Repo committen.

# Postgres-Admin-Passwort (für vokabel_admin)
PG_PASSWORD=ersetz-mich-stark

# Anwendungs-User-Passwort (für vokabel_app, wird von PostgREST genutzt)
APP_PASSWORD=ersetz-mich-stark-auch

# JWT-Secret (mind. 32 Zeichen). Mit diesem Secret werden anon/service_role-Keys signiert.
# Generieren: openssl rand -base64 48
JWT_SECRET=mindestens-32-zeichen-langer-zufallsstring-ersetzen
